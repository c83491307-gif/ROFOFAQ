<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ROFOF" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#147D64</item>
    </style>
    <style name="Theme.ROFOF.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rofof_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/sym_def_app_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ROFOF</item>
    </style>
</resources>
